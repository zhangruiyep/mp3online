#APP specific configuration.
config BF0_HCPU
    bool
    default y

config CUSTOM_MEM_MAP
    bool
	select custom_mem_map
	default y if !SOC_SIMULATOR

config ENABLE_DFU
    bool "enable dfu and add dfu sub-project"
	default n

config MP3_RINGBUFF
    bool "enable mp3 ringbuff for stream download and play"
    depends on AUDIO_LOCAL_MUSIC
    default y

config LV_GPU_SOFT_DECODER
    bool "enable software decoder for jpeg dynamic load"
    default y

config WEBCLIENT_DEBUG
    bool "enable webclient debug"
    default n

config IMAGE_CACHE_IN_PSRAM_SIZE
    int "image cache size in psram"
    default 1000000

rsource "../src/Kconfig"